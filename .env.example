# ── SpiceRoute Kitchen Environment Configuration ─────────────────────────────
# Copy this file to .env and insert your production API keys

# ── Groq LLM Configuration ──────────────────────────────────────────────────
# API Key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (default: openai/gpt-oss-120b for high reasoning, openai/gpt-oss-20b for fast tasks)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Qdrant Vector Cloud Configuration ─────────────────────────────────────────
# Obtain cluster URL and API key from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── Deployment Server Settings ───────────────────────────────────────────────
PORT=8501
HOST=0.0.0.0

# ── Table Split Mode Configuration ──────────────────────────────────────────
TABLE_SPLIT_ENABLED=false
AI_PARSER_ENABLED=false
TABLE_SPLIT_SESSION_TTL_MINUTES=180
TABLE_SPLIT_ROOM_CODE_PREFIX=TAB
TABLE_SPLIT_ROOM_CODE_SUFFIX_LEN=4
RESTAURANT_GST_BPS=500
TABLE_SPLIT_DB_PATH=data/table_split.db

